# Production Database URL (connects to qualiv_postgres via shared-infra or host)
# Dari dalam Docker container (shared-infra):
DATABASE_URL="postgresql://qualiv:d74b3b3a10870ef988f874746aad0d552b9f4f313722f8e6@qualiv_postgres:5432/wwcons_db?schema=public"

# Dari Host (saat prisma migrate):
# DATABASE_URL="postgresql://qualiv:d74b3b3a10870ef988f874746aad0d552b9f4f313722f8e6@127.0.0.1:5434/wwcons_db?schema=public"

# Auth Secret (ganti dengan random string aman 32+ karakter)
JWT_SECRET="wwcons-secret-key-production-change-this-random-string-12345"

# Server Port
PORT=3050
NODE_ENV=production
